<%--
    Demo identity for the no-login build.

    The report says the Management-staff account is seeded because Login 8 is
    outside the two detailed modules. This fragment creates the same seeded
    staff object that database/02-seed.sql stores (id 1, username "admin",
    full name "Trần Thị B"), so the boundary class can declare the
    currentStaff attribute without implementing a login flow.
--%>
<%
    ManagementStaff8 currentStaff = new ManagementStaff8();
    currentStaff.setId(1);
    currentStaff.setUsername("admin");
    currentStaff.setRole("Management staff");

    FullName8 currentStaffName = new FullName8();
    currentStaffName.setId(1);
    currentStaffName.setSurname("Trần");
    currentStaffName.setMiddleName("Thị");
    currentStaffName.setGivenName("B");
    currentStaff.setFullName(currentStaffName);
%>
